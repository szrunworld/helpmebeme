---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionNav from "../components/SectionNav";
import SiteHeader from "../components/SiteHeader.astro";
import {
  ArrowRightIcon,
  BookOpenIcon,
  ChartBarIcon,
  CheckCircleIcon,
  CircleIcon,
  InfoIcon,
  LeafIcon,
  LockKeyIcon,
  LockSimpleIcon,
  MinusCircleIcon,
  QuestionIcon,
  SunHorizonIcon,
  TargetIcon,
} from "@phosphor-icons/react";
---

<BaseLayout
  title="HelpMeBe.Me — Product & Brand Reference"
  description="HelpMeBe.Me 的产品理念、品牌标识、设计系统、产品设计稿与市场验证参考文档。"
>
<script is:inline>
  (() => {
    const sections = ['sec-why', 'sec-logo', 'sec-ds', 'sec-wf', 'sec-gtm'];
    const requested = window.location.hash.slice(1);
    const requestedView = new URLSearchParams(window.location.search).get('view');
    document.documentElement.dataset.docSection = sections.includes(requested) ? requested : 'sec-why';
    if (requestedView === 'reflection') document.documentElement.dataset.prototypeFocus = 'reflection';
  })();
</script>
<style is:global>
  /* ============ Design Tokens ============ */
  :root{
    --paper:#FAF8F3;
    --surface:#FFFFFF;
    --surface-warm:#FDFCF8;
    --ink:#26241F;
    --ink-soft:#57534A;
    --ink-faint:#8A857B;
    --line:#E8E4DB;
    --line-soft:#F0EDE5;
    --accent:#3E5C52;
    --accent-deep:#2E463E;
    --accent-soft:#E9EFEA;
    --accent-faint:#F3F6F3;

    --cat-building:#5B7186;
    --cat-comm:#B98F5F;
    --cat-reading:#7E9377;
    --cat-admin:#A59E93;
    --cat-personal:#A98794;
    --cat-entertain:#8F86A8;
    --cat-private:#6B6862;
    --cat-unclassified:#B8B3AB;

    --serif:"Newsreader","Source Serif 4",Charter,Georgia,"Songti SC",serif;
    --sans:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
    --mono:"SF Mono","JetBrains Mono",ui-monospace,Menlo,monospace;

    --r-sm:8px; --r-md:12px; --r-lg:16px; --r-xl:24px;
    --shadow-sm:0 1px 2px rgba(38,36,31,.05);
    --shadow-md:0 2px 12px rgba(38,36,31,.07);
    --shadow-lg:0 8px 32px rgba(38,36,31,.10);
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background:#F2EFE8;
    background-image:radial-gradient(circle at 50% 0,rgba(255,255,255,.9),rgba(242,239,232,0) 520px);
    color:var(--ink);
    font-family:var(--sans);
    font-size:15px;
    line-height:1.65;
    -webkit-font-smoothing:antialiased;
  }
  ::selection{background:var(--accent-soft);}

  /* ============ Page chrome ============ */
  .docs-nav-shell{
    position:sticky;top:14px;z-index:50;
    width:100%;padding:0 24px;margin-top:-27px;
  }
  .docs-nav-frame{
    width:min(960px,100%);margin:0 auto;padding:6px;
    border:1px solid rgba(216,211,200,.9);border-radius:18px;
    background:rgba(253,252,248,.9);box-shadow:0 10px 35px rgba(38,36,31,.09);
    backdrop-filter:blur(18px);
  }
  .docs-nav-scroll-area{width:100%;overflow:hidden;border-radius:13px;}
  .docs-nav-viewport{width:100%;}
  .docs-nav-list{
    min-width:760px;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:4px;
  }
  .docs-nav-item{
    appearance:none;border:0;border-radius:12px;background:transparent;cursor:pointer;
    padding:11px 14px;display:flex;align-items:center;justify-content:center;gap:10px;
    color:var(--ink-faint);font-family:var(--sans);text-align:left;
    transition:background .18s,color .18s,box-shadow .18s;
  }
  .docs-nav-item:hover{background:rgba(38,36,31,.04);color:var(--ink);}
  .docs-nav-item[data-state="on"]{
    background:var(--ink);color:#fff;box-shadow:0 5px 15px rgba(38,36,31,.16);
  }
  .docs-nav-number{font-family:var(--mono);font-size:10px;opacity:.58;}
  .docs-nav-copy{display:flex;flex-direction:column;line-height:1.15;}
  .docs-nav-copy strong{font-size:12.5px;font-weight:650;white-space:nowrap;}
  .docs-nav-copy small{margin-top:4px;font-size:9px;letter-spacing:.08em;text-transform:uppercase;opacity:.58;}
  .docs-nav-scrollbar{display:flex;height:4px;touch-action:none;user-select:none;background:transparent;}
  .docs-nav-thumb{position:relative;flex:1;border-radius:99px;background:rgba(62,92,82,.25);}

  .doc-section{
    max-width:1120px;margin:36px auto 96px;padding:72px 72px 92px;display:none;
    background:rgba(253,252,248,.94);border:1px solid var(--line);border-radius:28px;
    box-shadow:0 24px 70px rgba(38,36,31,.08),0 2px 5px rgba(38,36,31,.035);
  }
  .doc-section.active{display:block;}
  html[data-doc-section] .doc-section{display:none;}
  html[data-doc-section="sec-why"] #sec-why,
  html[data-doc-section="sec-logo"] #sec-logo,
  html[data-doc-section="sec-ds"] #sec-ds,
  html[data-doc-section="sec-wf"] #sec-wf,
  html[data-doc-section="sec-gtm"] #sec-gtm{display:block;}

  .sec-label{
    font-size:12px;letter-spacing:.16em;text-transform:uppercase;
    color:var(--accent);font-weight:700;margin-bottom:12px;text-align:center;
  }
  .sec-title{font-family:var(--serif);font-size:32px;line-height:1.24;font-weight:500;letter-spacing:-.02em;margin-bottom:16px;text-align:center;}
  .sec-intro{color:var(--ink-soft);max-width:700px;margin:0 auto 54px;text-align:center;font-size:15px;line-height:1.85;}

  .sub-h{
    font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-faint);
    font-weight:700;margin:52px 0 20px;display:flex;align-items:center;gap:14px;
  }
  .sub-h::after{content:"";flex:1;height:1px;background:var(--line);}

  .card{
    background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);
    box-shadow:var(--shadow-sm);
  }
  .grid{display:grid;gap:20px;}
  .g2{grid-template-columns:1fr 1fr;}
  .g3{grid-template-columns:1fr 1fr 1fr;}
  .g4{grid-template-columns:repeat(4,1fr);}
  @media(max-width:900px){.g2,.g3,.g4{grid-template-columns:1fr;}}

  @media(max-width:1180px){
    .doc-section{width:calc(100% - 48px);}
  }

  .note{color:var(--ink-faint);font-size:13px;line-height:1.6;}

  /* ============ Logo section ============ */
  .logo-hero{
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    padding:88px 40px;gap:28px;background:var(--surface);
    border:1px solid var(--line);border-radius:var(--r-xl);box-shadow:var(--shadow-md);
  }
  .lockup{display:flex;align-items:center;gap:18px;}
  .lockup .wordmark{font-family:var(--serif);font-size:32px;font-weight:500;letter-spacing:-.015em;color:var(--ink);}
  .lockup .wordmark .tld{color:var(--ink-faint);font-weight:400;}
  .logo-hero .slogan{font-family:var(--serif);font-style:italic;font-size:16px;color:var(--ink-faint);}

  .concept-row{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:20px;}
  @media(max-width:900px){.concept-row{grid-template-columns:1fr;}}
  .concept-cell{padding:28px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:14px;}
  .concept-cell .glyph{height:72px;display:flex;align-items:center;justify-content:center;}
  .concept-cell h4{font-size:14px;font-weight:600;}
  .concept-cell p{font-size:13px;color:var(--ink-soft);}

  .variant-cell{padding:0;overflow:hidden;display:flex;flex-direction:column;}
  .variant-stage{height:170px;display:flex;align-items:center;justify-content:center;}
  .variant-name{padding:12px 18px;border-top:1px solid var(--line);font-size:12.5px;color:var(--ink-faint);display:flex;justify-content:space-between;align-items:center;}
  .stage-dark{background:#26241F;}
  .stage-accent{background:var(--accent);}
  .stage-paper{background:var(--paper);}

  .appicon{
    width:96px;height:96px;border-radius:22px;
    display:flex;align-items:center;justify-content:center;
    box-shadow:0 4px 16px rgba(38,36,31,.18), inset 0 1px 0 rgba(255,255,255,.35);
  }

  /* ---- Section 0 : Why ---- */
  .why-hero{background:var(--ink);color:#F3F1EA;border-radius:20px;padding:56px 48px;text-align:center;margin-bottom:26px;}
  .why-hero .wh-line{font-family:var(--serif);font-size:24px;font-weight:500;line-height:1.6;max-width:640px;margin:0 auto 14px;}
  .why-hero .wh-sub{font-size:13.5px;color:rgba(243,241,234,.62);}
  .chain{display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;padding:26px 20px;}
  .chain .ch{font-family:var(--serif);font-size:15.5px;padding:9px 18px;border:1px solid var(--line);border-radius:99px;background:var(--surface);}
  .chain .ch.hl{border-color:var(--accent);background:var(--accent-faint);color:var(--accent-deep);font-weight:500;}
  .chain .ar{color:var(--ink-faint);font-size:13px;}
  .why-quote{border-left:3px solid var(--accent);padding:6px 0 6px 22px;margin:20px 0;}
  .why-quote p{font-family:var(--serif);font-size:19px;line-height:1.65;}
  .why-quote span{display:block;font-size:12.5px;color:var(--ink-faint);margin-top:6px;font-family:var(--sans);}
  .prose{font-size:14.5px;line-height:1.85;color:var(--ink-soft);max-width:720px;}
  .prose + .prose{margin-top:12px;}
  .prose b{color:var(--ink);font-weight:600;}
  .not-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;}
  @media(max-width:900px){.not-grid{grid-template-columns:1fr;}}
  .not-cell{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:14px 18px;}
  .not-cell b{display:block;font-size:13px;margin-bottom:3px;}
  .not-cell b::before{content:"× ";color:#A5806E;}
  .not-cell span{font-size:12px;color:var(--ink-faint);line-height:1.6;}
  .prin-row{display:flex;gap:16px;padding:12px 0;border-bottom:1px solid var(--line-soft);align-items:baseline;}
  .prin-row:last-child{border-bottom:none;}
  .prin-row b{width:300px;flex-shrink:0;font-family:var(--serif);font-size:15px;font-weight:500;}
  .prin-row span{font-size:13px;color:var(--ink-soft);}

  .vchain{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-top:20px;}
  @media(max-width:900px){.vchain{grid-template-columns:1fr;}}
  .vchain .vc{background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:13px 15px;}
  .vchain .vc b{display:block;font-family:var(--serif);font-size:14.5px;margin-bottom:5px;color:var(--accent-deep);}
  .vchain .vc span{font-size:11.5px;color:var(--ink-soft);line-height:1.6;display:block;}
  .vchain .vc i{display:block;font-style:normal;font-size:11.5px;color:var(--ink);font-weight:600;margin-top:7px;}
  .msg-step{display:flex;gap:16px;padding:12px 0;border-bottom:1px solid var(--line-soft);align-items:baseline;}
  .msg-step:last-child{border-bottom:none;}
  .msg-step .mn{width:26px;height:26px;border-radius:50%;background:var(--accent-soft);color:var(--accent-deep);font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;transform:translateY(4px);}
  .msg-step .mt{width:64px;flex-shrink:0;font-size:12px;font-weight:700;color:var(--ink-faint);letter-spacing:.05em;transform:translateY(1px);}
  .msg-step p{font-family:var(--serif);font-size:15.5px;flex:1;}
  .ph-table{width:100%;border-collapse:collapse;font-size:12.5px;}
  .ph-table td{padding:11px 14px;border-bottom:1px solid var(--line-soft);vertical-align:top;line-height:1.65;color:var(--ink-soft);}
  .ph-table tr:last-child td{border-bottom:none;}
  .ph-table td:first-child{width:120px;font-weight:600;color:var(--ink);white-space:nowrap;}
  .ph-table td:last-child{width:220px;color:var(--ink-faint);}
  .ladder-row{display:flex;gap:16px;padding:11px 0;border-bottom:1px solid var(--line-soft);align-items:baseline;}
  .ladder-row:last-child{border-bottom:none;}
  .ladder-row b{width:96px;flex-shrink:0;font-family:var(--mono);font-size:12px;color:var(--accent-deep);}
  .price-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;}
  @media(max-width:900px){.price-grid{grid-template-columns:1fr;}}
  .price-cell{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:18px 20px;}
  .price-cell b{display:block;font-size:14px;margin-bottom:5px;}
  .price-cell span{font-size:12.5px;color:var(--ink-faint);line-height:1.7;display:block;}
  .ladder-row span{font-size:13px;color:var(--ink-soft);}
  .bx-row{display:flex;gap:18px;padding:11px 0;border-bottom:1px solid var(--line-soft);align-items:baseline;}
  .bx-row:last-child{border-bottom:none;}
  .bx-row b{width:110px;flex-shrink:0;font-size:11.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-faint);font-weight:700;}
  .bx-row p{font-family:var(--serif);font-size:15.5px;flex:1;}
  .bx-row p span{display:block;font-size:12px;color:var(--ink-faint);font-family:var(--sans);margin-top:3px;}
  .ph-table.two td:first-child{width:150px;}
  .ph-table.two td:last-child{width:auto;color:var(--ink-soft);}
  .ph-table.risk td:first-child{white-space:normal;width:150px;}
  .donts{list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:10px 28px;}
  @media(max-width:700px){.donts{grid-template-columns:1fr;}}
  .donts li{font-size:13.5px;color:var(--ink-soft);padding-left:22px;position:relative;}
  .donts li::before{content:"×";position:absolute;left:0;color:#A5806E;font-weight:700;}
</style>

<SiteHeader />
<SectionNav client:only="react" />

<main id="content">
<!-- ================= SECTION 0 : WHY ================= -->
<section class="doc-section active" id="sec-why">
  <div class="sec-label">00 · Why HelpMeBe.Me</div>
  <h2 class="sec-title">看见，是改变的开始</h2>
  <p class="sec-intro">Visibility is the beginning of change. 这一节是产品的来处：为什么做 HelpMeBe.Me、它相信什么，以及这些信念如何决定了后面每一页设计。之后才是 ① 品牌标识、② 设计系统、③ 产品设计稿、④ 市场与验证。</p>

  <div class="why-hero">
    <div class="wh-line">我们每天关注太多人、太多事，也不断希望被世界理解，却很少真正停下来，看看自己。</div>
    <div class="wh-sub">HelpMeBe.Me 想做的，是把注意力重新带回你本人。</div>
  </div>

  <div class="sub-h">最初的想法 · 每天值得做的五件事</div>
  <div class="card" style="padding:26px 32px;">
    <div class="vchain" style="margin-top:0;">
      <div class="vc"><b>Write</b><span>表达使模糊的想法变得清晰</span></div>
      <div class="vc"><b>Read</b><span>新的输入改变认知边界</span></div>
      <div class="vc"><b>Think</b><span>避免只是更快地忙碌</span></div>
      <div class="vc"><b>Move</b><span>身体是一切事情的基础设施</span></div>
      <div class="vc"><b>Remember</b><span>回顾时间去了哪里，理解真实行为</span></div>
    </div>
    <p class="prose" style="margin-top:16px;">最初的想法很简单：一个人每天是否至少应该写一点、读一点、认真想一想、让身体动起来，并回顾自己的时间去了哪里？但我们很快意识到：如果把这五件事做成勾选框、连续签到或完成率，它就会变成另一个 Habit Tracker——<b>用户会为了「完成」而表演，而不是为了理解自己而记录。</b>这与产品想解决的问题正好相反。所以第一版不做这五个任务，先做那件更基础的事：看见。</p>
  </div>

  <div class="sub-h">起点 · 从「记录可以改命」到 Visibility</div>
  <div class="card" style="padding:28px 32px;">
    <p class="prose">最初的灵感来自一句朴素的话：<b>「记录真的可以改命。」</b>后来我们意识到，改变人生的从来不是记录本身——记录创造看见，看见带来觉察，觉察让新的选择成为可能：</p>
    <div class="chain">
      <span class="ch">Record</span><span class="ar">→</span>
      <span class="ch hl">Visibility</span><span class="ar">→</span>
      <span class="ch">Awareness</span><span class="ar">→</span>
      <span class="ch">Reflection</span><span class="ar">→</span>
      <span class="ch">Choice</span><span class="ar">→</span>
      <span class="ch hl">Change</span>
    </div>
    <p class="prose">记录不是终点。没有回顾的记录只是存档，没有选择的反思也不会产生变化。HelpMeBe.Me 只对前几步负责：<b>把事实整理得足够清楚，让更有意识的选择成为可能。</b>它不要求你变得更自律，而是先帮你看见真实——不打分、不评判、不制造内疚，也不假装电脑数据代表整个人生。</p>
  </div>

  <div class="sub-h">名字的含义 · Being seen is the beginning of becoming</div>
  <div class="card" style="padding:28px 32px;">
    <div class="why-quote">
      <p>Being seen is the beginning of becoming.</p>
      <span>被看见，是成为的开始。</span>
    </div>
    <p class="prose">这里的「被看见」，首先不是被公众看见，也不是获得外部认可，而是<b>被自己看见</b>：看见自己的时间去了哪里、反复做出了什么选择、哪些事情真正给予能量、哪些只是消耗。只有自己先看见自己，才更可能被别人准确地理解和看见。</p>
    <p class="prose">这也是产品名的含义——HelpMeBe.Me 不是 <i>Help me look better</i>，而是 <b><i>Help me see myself, so I can become more intentionally</i></b>。它不帮你打造一个更好看的自我形象，也不鼓励你把人生变成向外展示的数据；它提供的是一种私人的 Self-Visibility：在没有表演、没有比较、没有外部评分的空间里，诚实地看见自己。</p>
  </div>

  <div class="sub-h">日记原则 · 不要在自己的日记里，对自己说谎</div>
  <div class="card" style="padding:28px 32px;">
    <div class="why-quote">
      <p>I will not lie to myself in my own journal.</p>
      <span>我不会在自己的日记里，对自己说谎。——写在创始人日记本第一页的一句话，也是 HelpMeBe.Me 与每一位用户的共勉。</span>
    </div>
    <p class="prose">日记可以不完整，记录可以有缺口，今天也可以没有任何值得保存的事情。但当我们决定回顾自己时，至少要尽可能诚实——不是写下一个更努力、更自律、更成功的自己，也不是为了向任何人证明什么，而是如实承认：<b>我的时间去了哪里，我在逃避什么，我真正重视什么，我反复选择了什么。</b></p>
    <p class="prose">这句话直接决定了产品态度：不要求用户表现得更好，而是尽量减少表演的动机——没有连续打卡、没有完成率、没有排名、没有公开展示，也不把休息定义为失败。<b>只有不对自己说谎，Visibility 才有意义；只有先看见真实，改变才可能开始。</b></p>
  </div>

  <div class="sub-h">核心观察 · You are what you spend your time on</div>
  <div class="card" style="padding:28px 32px;">
    <div class="why-quote">
      <p>你的时间投向哪里，你的人生就会在那里生长。</p>
    </div>
    <p class="prose">人会说自己重视健康、家人、学习与创造，但真实的时间分配经常与自我描述不同。多数人并不缺少建议，也不是不知道该做什么——<b>他们缺少的是对自己真实行为的可见性。</b></p>
    <p class="prose">所以 HelpMeBe.Me 不先问「你今天完成了吗」，而是先回答「你今天实际上做了什么」。先观察，再优化——<b>Observation before optimization.</b></p>
  </div>

  <div class="sub-h">核心隐喻 · A private mirror for your time</div>
  <div class="card" style="padding:28px 32px;display:flex;gap:28px;align-items:center;flex-wrap:wrap;">
    <svg width="64" height="64" viewBox="0 0 48 48" fill="none" style="flex-shrink:0;">
      <path d="M 27.88 9.51 A 15 15 0 1 0 38.49 20.12" stroke="#3E5C52" stroke-width="3" stroke-linecap="round"/>
      <circle cx="34.6" cy="13.4" r="2.7" fill="#3E5C52"/>
    </svg>
    <p class="prose" style="flex:1;min-width:260px;">镜子不命令你应该长成什么样，也不会替你生活，它只是让原本看不清的东西变得可见。HelpMeBe.Me 的职责同样不是判断你是否高效、成功或自律，而是<b>准确、克制地呈现你允许它看到的事实</b>——符号上那个永远不闭合的缺口，就是它承认自己看不见、也不假装看见的部分。</p>
  </div>

  <div class="sub-h">定位 · 一句话定义</div>
  <div class="card" style="padding:28px 32px;">
    <div class="why-quote">
      <p>HelpMeBe.Me 是一款隐私优先的个人时间与记忆工具：自动帮你看见时间去了哪里，并由你决定什么值得长期记住。</p>
      <span>A privacy-first personal time &amp; memory tool that organizes how you spend your time, helps you review your day honestly, and lets you intentionally preserve what matters.</span>
    </div>
    <div class="vchain">
      <div class="vc"><b>Capture</b><span>在授权范围内自动记录活动</span><i>减少手动记录负担</i></div>
      <div class="vc"><b>Organize</b><span>碎片窗口合并为 Activity Block</span><i>知道「我刚才在做什么」</i></div>
      <div class="vc"><b>Review</b><span>10 秒 Today 摘要 + 一个值得注意的事实</span><i>获得 Visibility</i></div>
      <div class="vc"><b>Remember</b><span>候选 Memory 由你确认、修改或拒绝</span><i>重要经历成为长期资产</i></div>
      <div class="vc"><b>Reflect</b><span>数据足够后展示变化与主题</span><i>理解自己正在如何变化</i></div>
    </div>
    <p class="prose" style="margin-top:16px;text-align:center;">三条产品承诺：<b>系统看到的 ≠ 永久记住 · AI 建议的 ≠ 用户事实 · 局部数据 ≠ 整个人生</b></p>
  </div>

  <div class="sub-h">参照系 · 从 Journal 到 AI Life Memory</div>
  <div class="card" style="padding:26px 32px;">
    <p class="prose">传统 Journal 的瓶颈不是人不会写，而是很难持续记录、也很少真正回顾。去年七月你最大的成长是什么？多数人答不出来——不是没有成长，而是缺少可检索、可反思、可形成长期模式的 Memory。</p>
    <p class="prose">所以 HelpMeBe.Me 不与 Day One、Journey、Notion 或 Apple Journal 正面竞争。它更接近一个 <b>AI Life Memory Companion</b>：自动形成事实基础，帮你决定什么值得长期留下，再在时间尺度上形成 Reflection。</p>
  </div>

  <div class="sub-h">战略 · 为什么是现在，从哪里切入</div>
  <div class="grid g2">
    <div class="card" style="padding:24px 28px;">
      <b style="font-size:13.5px;">为什么现在有机会</b>
      <p class="prose" style="margin-top:10px;font-size:13.5px;">桌面行为数据、LLM 语义归并与长期检索，第一次可以组合成这种体验；知识工作者的时间碎片化与「忙碌但说不清忙了什么」长期存在；成熟的桌面端记录与 AI 摘要底座让第一版可以低成本快速验证；而当多数 Recall 产品追求「保存一切」时，<b>「理解后尽量少保存」本身成为差异化。</b></p>
    </div>
    <div class="card" style="padding:24px 28px;">
      <b style="font-size:13.5px;">Wedge · 从电脑时间切入</b>
      <p class="prose" style="margin-top:10px;font-size:13.5px;">长期愿景可以是 Life Memory，但第一步不试图理解整个人生。最可信、最容易验证的切入口是电脑活动——MVP 只做 <b>Spend + Remember</b>：时间去了哪里，以及什么值得记住。Write / Read / Think / Move 是未来的观察维度，不是第一版的任务清单。</p>
    </div>
  </div>

  <div class="card" style="padding:24px 32px;margin-top:18px;">
    <b style="font-size:13.5px;">产品飞轮 · 越用越懂你</b>
    <div class="chain" style="padding:20px 0 14px;">
      <span class="ch">记录你允许看到的</span><span class="ar">→</span>
      <span class="ch">AI 合并为个人语义</span><span class="ar">→</span>
      <span class="ch hl">你纠正，它学习</span><span class="ar">→</span>
      <span class="ch">越来越懂你的分类方式</span><span class="ar">→</span>
      <span class="ch">更准的 Today 与 Memory</span><span class="ar">→</span>
      <span class="ch hl">信任与回访</span>
    </div>
    <p class="prose" style="font-size:13.5px;">真正的护城河不是通用模型，而是长期形成的 <b>Personal Taxonomy</b>、你亲手确认的 Memory、项目历史与可信的数据解释关系——这些只属于你，也只在这里积累。</p>
  </div>

  <div class="sub-h">它明确不是什么</div>
  <div class="not-grid">
    <div class="not-cell"><b>Habit Tracker</b><span>不打卡、不连续签到、没有完成率、勋章与红色提醒。</span></div>
    <div class="not-cell"><b>员工监控</b><span>没有管理员、团队排名、考勤或雇主访问。</span></div>
    <div class="not-cell"><b>Productivity Score</b><span>不把创造视为好、休息视为坏。</span></div>
    <div class="not-cell"><b>传统日记</b><span>不依赖你每天写长文本。</span></div>
    <div class="not-cell"><b>AI 人生教练</b><span>不给人生处方，不做心理诊断或人格判断。</span></div>
    <div class="not-cell"><b>全量录屏</b><span>默认不截图、不记录键盘输入，原始活动自动过期。</span></div>
  </div>

  <div class="sub-h">产品原则 · 每一页设计的依据</div>
  <div class="card" style="padding:20px 32px;">
    <div class="prin-row"><b>Attention back to self</b><span>把注意力从外界带回自己。</span></div>
    <div class="prin-row"><b>Honesty before optimization</b><span>先对自己诚实，再谈优化和改变。</span></div>
    <div class="prin-row"><b>Visibility before judgment</b><span>先看见，不评价。</span></div>
    <div class="prin-row"><b>Observation before optimization</b><span>先观察，再优化。</span></div>
    <div class="prin-row"><b>Facts before advice</b><span>先呈现事实，再考虑建议。</span></div>
    <div class="prin-row"><b>Reflection before action</b><span>先理解，再改变。</span></div>
    <div class="prin-row"><b>Privacy before intelligence</b><span>隐私先于智能。</span></div>
    <div class="prin-row"><b>Summary over surveillance</b><span>摘要优先于保存全部原始数据。</span></div>
    <div class="prin-row"><b>User interpretation over AI authority</b><span>最终解释权属于用户。</span></div>
  </div>

  <div class="logo-hero" style="margin-top:26px;">
    <div class="slogan" style="margin-bottom:14px;">HelpMeBe.Me 自动整理你允许它看到的时间，让你诚实地看见自己如何生活，并由你决定什么值得被记住。</div>
    <div style="font-family:var(--serif);font-size:19px;color:var(--accent-deep);">Record automatically. Review honestly. Remember intentionally.</div>
    <div class="slogan" style="margin-top:10px;font-size:13px;">自动记录，诚实回顾，有意记住。—— 接下来，看这些信念如何落进 ① 符号、② 系统、③ 每一个页面，以及 ④ 走向市场的方式。</div>
  </div>
</section>

