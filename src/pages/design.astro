<script>
  // Wireframe views
  function showView(id: string | undefined) {
    if (!id) return;

    const nextView = document.getElementById(id);
    if (!nextView) return;

    document.querySelectorAll<HTMLElement>('.wf-view').forEach((view) => view.classList.remove('active'));
    nextView.classList.add('active');
    document.querySelectorAll<HTMLElement>('.wf-switch [data-view]').forEach((button) =>
      button.classList.toggle('active', button.dataset.view === id));
    document.querySelectorAll<HTMLElement>('.side-nav [data-view]').forEach((link) =>
      link.classList.toggle('active', link.dataset.view === id));
    nextView.closest<HTMLElement>('.app-frame')?.setAttribute('data-active-view', id);
  }

  document.querySelectorAll<HTMLElement>('.wf-switch [data-view], .side-nav [data-view]').forEach((element) =>
    element.addEventListener('click', (event) => {
      event.preventDefault();
      showView(element.dataset.view);
    }));

  const requestedWireframe = new URLSearchParams(window.location.search).get('view');
  if (requestedWireframe === 'reflection') showView('v-reflection');

  function togglePanel(id: string | undefined, trigger: HTMLElement) {
    if (!id) return;
    const panel = document.getElementById(id);
    if (!panel) return;

    const open = panel.classList.toggle('open');
    trigger.setAttribute('aria-expanded', String(open));
  }

  document.addEventListener('click', (event) => {
    const eventTarget = event.target;
    if (!(eventTarget instanceof Element)) return;

    const trigger = eventTarget.closest<HTMLElement>('[data-action]');
    if (!trigger) return;

    const targetId = trigger.dataset.target;

    switch (trigger.dataset.action) {
      case 'toggle-panel':
        togglePanel(targetId, trigger);
        break;
      case 'toggle-details': {
        const details = document.getElementById('today-detail');
        if (!details) break;
        const open = details.classList.toggle('open');
        trigger.textContent = open ? 'Hide details ▴' : 'Review details ▾';
        trigger.setAttribute('aria-expanded', String(open));
        break;
      }
      case 'toggle-suggestions': {
        const suggestions = document.getElementById('sugg-more');
        if (!suggestions) break;
        const open = suggestions.classList.toggle('open');
        trigger.textContent = open ? 'Show fewer ▴' : 'See other suggestions (2) ▾';
        trigger.setAttribute('aria-expanded', String(open));
        break;
      }
      case 'memory-keep':
      case 'memory-skip': {
        if (!targetId) break;
        const candidate = document.getElementById(targetId);
        if (!candidate) break;
        const shouldKeep = trigger.dataset.action === 'memory-keep';
        candidate.classList.toggle('saved', shouldKeep);
        candidate.classList.toggle('ignored', !shouldKeep);
        break;
      }
      case 'dismiss-learning':
        if (targetId) document.getElementById(targetId)?.classList.add('done');
        break;
      case 'mirror-feedback': {
        const feedback = trigger.dataset.feedback;
        document.querySelectorAll<HTMLElement>('[data-action="mirror-feedback"]').forEach((button) => {
          const selected = button === trigger;
          button.classList.toggle('active', selected);
          button.setAttribute('aria-pressed', String(selected));
        });

        const contextForm = document.getElementById('mirror-context-form');
        contextForm?.classList.toggle('open', feedback === 'missing-context');

        const mirrorStatus = document.getElementById('mirror-status');
        if (mirrorStatus) {
          mirrorStatus.textContent = feedback === 'true'
            ? 'Thanks — this pattern will stay connected to its evidence.'
            : feedback === 'not-quite'
              ? 'Thanks — HelpMeBe.Me will treat this as uncertain.'
              : feedback === 'missing-context'
                ? 'Add only what feels useful; you can remove it later.'
                : '';
        }
        break;
      }
      case 'mirror-save-context': {
        const contextInput = document.getElementById('mirror-context');
        const mirrorStatus = document.getElementById('mirror-status');
        if (contextInput instanceof HTMLTextAreaElement && mirrorStatus) {
          mirrorStatus.textContent = contextInput.value.trim()
            ? 'Context added to this reflection.'
            : 'Write a little context before adding it.';
        }
        break;
      }
      case 'mirror-experiment': {
        const experimentButton = document.getElementById('mirror-experiment');
        const observeButton = document.getElementById('mirror-observe');
        const mirrorStatus = document.getElementById('mirror-status');
        experimentButton?.classList.add('saved');
        observeButton?.classList.remove('active');
        if (experimentButton) experimentButton.textContent = 'Experiment saved';
        if (mirrorStatus) mirrorStatus.textContent = 'We’ll bring this back in next week’s Mirror and ask whether it helped.';
        break;
      }
      case 'mirror-observe': {
        const experimentButton = document.getElementById('mirror-experiment');
        const observeButton = document.getElementById('mirror-observe');
        const mirrorStatus = document.getElementById('mirror-status');
        experimentButton?.classList.remove('saved');
        if (experimentButton) experimentButton.textContent = 'Try this next week';
        observeButton?.classList.add('active');
        if (mirrorStatus) mirrorStatus.textContent = 'No change this week. HelpMeBe.Me will keep observing this pattern.';
        break;
      }
    }
  });
</script>
</BaseLayout>
