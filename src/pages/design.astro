  .wf-switch button.active{background:var(--ink);border-color:var(--ink);color:#fff;font-weight:600;}

  .app-frame{border:1px solid var(--line);border-radius:14px;overflow:hidden;box-shadow:var(--shadow-lg);background:var(--surface-warm);}
  .app-titlebar{height:38px;background:var(--paper);border-bottom:1px solid var(--line);display:flex;align-items:center;padding:0 14px;gap:8px;}
  .app-titlebar .dot{width:11px;height:11px;border-radius:50%;background:#DDD8CD;}
  .app-titlebar .tb-title{flex:1;text-align:center;font-size:12px;color:var(--ink-faint);margin-right:57px;}

  .app-body{display:flex;min-height:640px;}
  .app-side{width:216px;flex-shrink:0;background:var(--paper);border-right:1px solid var(--line);display:flex;flex-direction:column;padding:20px 12px 16px;}
  .side-brand{display:flex;align-items:center;gap:9px;padding:0 10px 18px;}
  .side-brand span{font-family:var(--serif);font-size:17px;font-weight:500;}
  .side-nav{display:flex;flex-direction:column;gap:2px;}
  .side-nav a{display:flex;align-items:center;gap:11px;padding:9px 12px;border-radius:10px;font-size:13.5px;color:var(--ink-soft);text-decoration:none;cursor:pointer;transition:background .15s,color .15s;}
  .side-nav a:hover{background:rgba(38,36,31,.045);}
  .side-nav a.active{background:var(--accent-soft);color:var(--accent-deep);font-weight:600;}
  .side-nav a svg{flex-shrink:0;opacity:.75;}
  .side-foot{margin-top:auto;display:flex;flex-direction:column;gap:10px;padding:0 4px;}
  .side-foot .pill-status{justify-content:center;font-size:12px;}
  .side-foot .note{text-align:center;font-size:11px;}
  .side-foot-reflection{display:none;}

  .app-main{flex:1;padding:36px 44px 44px;overflow:hidden;}
  .wf-view{display:none;animation:fadein .25s ease;}
  .wf-view.active{display:block;}
  @keyframes fadein{from{opacity:0;transform:translateY(4px);}to{opacity:1;transform:none;}}

  .v-date{font-size:12.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-faint);font-weight:600;margin-bottom:6px;}
  .v-title{font-family:var(--serif);font-size:24px;font-weight:500;letter-spacing:-.01em;margin-bottom:4px;}
  .v-sub{color:var(--ink-faint);font-size:13.5px;margin-bottom:26px;}

  /* ---- Today: 10-second layer ---- */
  .glance-sentence{font-family:var(--serif);font-size:20px;line-height:1.6;max-width:620px;margin-bottom:24px;}
  .glance-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:14px;margin-bottom:14px;}
  @media(max-width:900px){.glance-grid{grid-template-columns:1fr;}}
  .glance-cell{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:18px 20px;}
  .glance-cell .gc-label{font-size:11.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-faint);font-weight:700;margin-bottom:10px;}
  .glance-cell .gc-row{display:flex;align-items:center;gap:9px;font-size:13.5px;padding:3px 0;}
  .glance-cell .gc-row i{width:8px;height:8px;border-radius:3px;font-style:normal;flex-shrink:0;}
  .glance-cell .gc-row code{margin-left:auto;font-family:var(--mono);font-size:13px;}
  .glance-cell .gc-big{font-family:var(--serif);font-size:16px;line-height:1.5;}
  .glance-cell .gc-meta{font-size:12px;color:var(--ink-faint);margin-top:6px;}

  .coverage{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px 20px;margin-bottom:22px;}
  .coverage .cv-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;}
  .coverage .cv-head b{font-size:12.5px;font-weight:600;}
  .cv-bar{display:flex;height:10px;border-radius:5px;overflow:hidden;gap:2px;margin-bottom:10px;}
  .cv-bar .seg-rec{background:var(--accent);opacity:.75;}
  .cv-bar .seg-priv{background:repeating-linear-gradient(45deg,#B5B0A6 0 4px,#D8D3C8 4px 8px);}
  .cv-bar .seg-off{background:var(--line-soft);}
  .cv-legend{display:flex;gap:20px;flex-wrap:wrap;font-size:12px;color:var(--ink-soft);}
  .cv-legend i{display:inline-block;width:9px;height:9px;border-radius:3px;margin-right:6px;font-style:normal;}

  /* inline memory */
  .inline-mem{background:var(--accent-faint);border:1px solid #DCE5DD;border-radius:14px;padding:20px 24px;margin-bottom:22px;}
  .inline-mem .im-q{font-family:var(--serif);font-size:16.5px;margin-bottom:12px;}
  .im-candidate{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:14px 18px;margin-bottom:10px;transition:opacity .3s,border-color .2s;}
  .im-candidate .src{font-size:11.5px;color:var(--ink-faint);margin-bottom:5px;display:flex;gap:8px;align-items:center;}
  .im-candidate p{font-family:var(--serif);font-size:15px;margin-bottom:11px;}
  .im-candidate .mem-acts{display:flex;gap:8px;}
  .im-candidate.saved{border-color:var(--accent);}
  .im-candidate.saved .mem-acts{display:none;}
  .im-candidate.saved .saved-flag{display:inline-flex;}
  .im-candidate.ignored{opacity:.38;}
  .im-candidate.ignored p{text-decoration:line-through;text-decoration-color:rgba(38,36,31,.3);}
  .saved-flag{display:none;align-items:center;gap:7px;font-size:12.5px;font-weight:600;color:var(--accent-deep);}
  .sugg-more{display:none;}
  .sugg-more.open{display:block;}
  .see-more{border:none;background:none;cursor:pointer;font-family:var(--sans);font-size:12.5px;color:var(--accent-deep);padding:2px 0;}
  .see-more:hover{text-decoration:underline;}

  .today-actions{display:flex;gap:10px;align-items:center;}
  .cv-line{font-size:12px;color:var(--ink-faint);margin:0 2px 20px;display:flex;align-items:center;gap:6px;flex-wrap:wrap;}
  .pg-h{font-size:11.5px;letter-spacing:.09em;text-transform:uppercase;color:var(--ink-faint);font-weight:700;margin:24px 2px 12px;}
  .pg-h:first-of-type{margin-top:0;}

  /* ---- detail layer ---- */
  .detail-layer{display:none;margin-top:30px;border-top:1px solid var(--line);padding-top:8px;}
  .detail-layer.open{display:block;}
  .catsum{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin:22px 0 26px;}
  @media(max-width:900px){.catsum{grid-template-columns:1fr 1fr;}}
  .catsum .cell{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:14px 16px;}
  .catsum .cell .nm{display:flex;align-items:center;gap:7px;font-size:12px;color:var(--ink-soft);margin-bottom:4px;}
  .catsum .cell .nm i{width:8px;height:8px;border-radius:3px;font-style:normal;flex-shrink:0;}
  .catsum .cell .tm{font-family:var(--mono);font-size:17px;font-weight:500;}
  .catsum .cell .bar{height:3px;border-radius:2px;background:var(--line-soft);margin-top:10px;overflow:hidden;}
  .catsum .cell .bar b{display:block;height:100%;border-radius:2px;}

  .tl{position:relative;padding-left:86px;}
  .tl::before{content:"";position:absolute;left:70px;top:6px;bottom:6px;width:1px;background:var(--line);}
  .tl-block{position:relative;margin-bottom:14px;}
  .tl-time{position:absolute;left:-86px;top:13px;width:56px;text-align:right;font-family:var(--mono);font-size:11px;color:var(--ink-faint);line-height:1.5;}
  .tl-node{position:absolute;left:-19.5px;top:18px;width:7px;height:7px;border-radius:3px;}
  .tl-card{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:13px 18px;display:flex;align-items:center;gap:12px;transition:border-color .15s,box-shadow .15s;position:relative;flex-wrap:wrap;}
  .tl-card:hover{border-color:#D5CFC2;box-shadow:var(--shadow-md);}
  .tl-card:hover .tl-actions{opacity:1;}
  .tl-main{flex:1;min-width:200px;}
  .tl-main b{display:block;font-size:14px;font-weight:600;}
  .tl-main span{font-size:12.5px;color:var(--ink-faint);}
  .tl-dur{font-family:var(--mono);font-size:12px;color:var(--ink-faint);white-space:nowrap;}
  .tl-actions{display:flex;gap:2px;opacity:0;transition:opacity .15s;position:absolute;right:10px;top:-14px;background:var(--surface);border:1px solid var(--line);border-radius:9px;padding:3px;box-shadow:var(--shadow-md);}
  .tl-actions button{appearance:none;border:none;background:none;cursor:pointer;font-family:var(--sans);font-size:11.5px;color:var(--ink-soft);padding:4px 9px;border-radius:6px;}
  .tl-actions button:hover{background:var(--line-soft);color:var(--ink);}
  .tl-notrec .tl-card{background:var(--paper);border-style:dashed;}
  .tl-unclassified .tl-card{border-style:dashed;}
  .why-toggle{border:none;background:none;cursor:pointer;font-family:var(--sans);font-size:11.5px;color:var(--accent-deep);padding:0;}
  .why-toggle:hover{text-decoration:underline;}
  .tl-why{display:none;flex-basis:100%;background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:12px 16px;font-size:12.5px;color:var(--ink-soft);line-height:1.65;margin-top:4px;}
  .tl-why.open{display:block;}
  .tl-why b{display:block;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-faint);margin-bottom:5px;}

  .learn-toast{flex-basis:100%;display:flex;align-items:center;gap:12px;background:var(--accent-faint);border:1px solid #DCE5DD;border-radius:10px;padding:9px 14px;font-size:12.5px;margin-top:4px;}
  .learn-toast.done{display:none;}
  .learn-toast .lt-q{flex:1;}
  .learn-toast button{appearance:none;cursor:pointer;font-family:var(--sans);font-size:12px;font-weight:600;padding:5px 12px;border-radius:8px;border:1px solid var(--line);background:var(--surface);color:var(--ink);}
  .learn-toast button.primary{background:var(--accent);border-color:var(--accent);color:#fff;}

  /* ---- Memories ---- */
  .memsearch{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:11px 18px;color:var(--ink-faint);font-size:13.5px;display:flex;align-items:center;gap:10px;margin-bottom:24px;opacity:.7;}
  .memgroup{margin-bottom:26px;}
  .memgroup .mg-date{font-size:11.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-faint);font-weight:700;margin-bottom:10px;}
  .memitem{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:14px 20px;margin-bottom:10px;display:flex;gap:14px;align-items:flex-start;}
  .memitem .mi-icon{flex-shrink:0;margin-top:3px;}
  .memitem p{font-family:var(--serif);font-size:15px;line-height:1.6;}
  .memitem .mi-meta{font-size:11.5px;color:var(--ink-faint);margin-top:4px;display:flex;gap:10px;align-items:center;flex-wrap:wrap;}

  /* ---- Weekly Mirror · Weekend Letter ---- */
  #sec-wf{max-width:1480px;padding-left:52px;padding-right:52px;}
  .app-frame[data-active-view="v-reflection"]{
    --mirror-display:28px;
    --mirror-title:22px;
    --mirror-body:15px;
    --mirror-ui:13.5px;
    --mirror-caption:12.5px;
    --mirror-numeric:13px;
    background:var(--surface-warm);box-shadow:0 18px 56px rgba(38,36,31,.11);
  }
  .app-frame[data-active-view="v-reflection"] .app-titlebar{display:none;}
  .app-frame[data-active-view="v-reflection"] .app-body{min-height:900px;}
  .app-frame[data-active-view="v-reflection"] .app-side{width:294px;padding:53px 18px 63px;}
  .app-frame[data-active-view="v-reflection"] .side-brand{padding:0 34px 30px;gap:18px;}
  .app-frame[data-active-view="v-reflection"] .side-brand svg{width:32px;height:32px;}
  .app-frame[data-active-view="v-reflection"] .side-brand span{font-size:17px;}
  .app-frame[data-active-view="v-reflection"] .side-nav{width:204px;gap:15px;margin:36px 0 0 14px;}
  .app-frame[data-active-view="v-reflection"] .side-nav a{gap:26px;padding:19px 22px;border-radius:99px;font-size:var(--mirror-ui);line-height:1.2;}
  .app-frame[data-active-view="v-reflection"] .side-nav a.active{background:rgba(233,239,234,.9);}
  .app-frame[data-active-view="v-reflection"] .side-foot{align-items:flex-start;padding:0 34px;gap:8px;}
  .app-frame[data-active-view="v-reflection"] .side-foot .pill-status{justify-content:flex-start;padding:0;background:transparent;border:0;}
  .app-frame[data-active-view="v-reflection"] .side-foot .note{text-align:left;}
  .app-frame[data-active-view="v-reflection"] .side-foot .pill-status{font-size:var(--mirror-caption);}
  .app-frame[data-active-view="v-reflection"] .side-foot .note{font-size:11.5px;}
  .app-frame[data-active-view="v-reflection"] .side-foot-default{display:none;}
  .app-frame[data-active-view="v-reflection"] .side-foot-reflection{display:inline;}
  .app-frame[data-active-view="v-reflection"] .app-main{padding:48px 82px 36px 70px;}

  .mirror-letter{max-width:1030px;margin:0;color:var(--ink);}
  .mirror-head{display:flex;align-items:flex-start;justify-content:space-between;gap:32px;margin-bottom:68px;}
  .mirror-kicker{font-size:var(--mirror-caption);line-height:1;letter-spacing:.18em;text-transform:uppercase;color:var(--accent);font-weight:750;margin-bottom:11px;}
  .mirror-period{font-family:var(--serif);font-size:var(--mirror-title);line-height:1.15;font-weight:500;letter-spacing:-.012em;}
  .mirror-days{font-size:var(--mirror-caption);color:var(--ink-faint);margin-top:8px;}
  .mirror-private{display:flex;align-items:flex-start;gap:10px;color:var(--ink-faint);font-size:var(--mirror-caption);line-height:1.55;text-align:left;padding-top:4px;}
  .mirror-private svg{margin-top:1px;flex-shrink:0;}

  .mirror-hero h3{font-family:var(--serif);font-size:var(--mirror-display);line-height:1.18;font-weight:500;letter-spacing:-.02em;margin:0;max-width:920px;}
  .mirror-summary{font-family:var(--serif);font-size:var(--mirror-body);line-height:1.65;color:var(--ink-soft);margin-top:16px;max-width:900px;}
  .mirror-distribution{display:grid;grid-template-columns:1.95fr 1.6fr 1.3fr 1fr;gap:8px;max-width:990px;margin-top:36px;padding-bottom:0;}
  .mirror-stat-head{display:flex;align-items:baseline;justify-content:space-between;gap:12px;color:var(--mirror-category);font-size:var(--mirror-ui);font-weight:600;}
  .mirror-stat-head code{font-family:var(--mono);font-size:var(--mirror-numeric);font-weight:500;white-space:nowrap;}
  .mirror-stat-line{height:7px;border-radius:99px;background:color-mix(in srgb,var(--mirror-category) 88%,white);margin-top:12px;}

  .mirror-insight{display:grid;grid-template-columns:90px minmax(0,1fr);gap:29px;padding:64px 0 33px;border-bottom:1px solid var(--line);}
  .mirror-icon{width:86px;height:86px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--accent-soft);color:var(--accent);}
  .mirror-insight h4{font-family:var(--serif);font-size:var(--mirror-title);line-height:1.35;font-weight:500;letter-spacing:-.012em;max-width:690px;}
  .mirror-feedback{display:flex;align-items:center;flex-wrap:wrap;gap:0;margin:26px 0 0 -113px;}
  .mirror-feedback button{appearance:none;border:0;border-right:1px solid var(--line);background:transparent;color:var(--accent);font-family:var(--sans);font-size:var(--mirror-ui);line-height:1;cursor:pointer;padding:6px 20px;display:inline-flex;align-items:center;gap:7px;transition:color .16s,background .16s;}
  .mirror-feedback button:first-child{padding-left:0;}
  .mirror-feedback button:last-child{border-right:0;}
  .mirror-feedback button:hover{color:var(--accent-deep);}
  .mirror-feedback button:last-child{text-decoration:underline dotted;text-decoration-color:rgba(62,92,82,.55);text-underline-offset:5px;}
  .mirror-feedback button.active{color:var(--accent-deep);font-weight:650;}
  .mirror-feedback button:focus-visible{border-radius:6px;}
  .mirror-evidence{display:none;margin-top:20px;background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:15px 18px;font-size:12.5px;color:var(--ink-soft);line-height:1.7;}
  .mirror-evidence.open{display:block;}
  .mirror-evidence b{display:block;font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);margin-bottom:5px;}
  .mirror-context-form{display:none;margin-top:18px;max-width:620px;}
  .mirror-context-form.open{display:block;}
  .mirror-context-form label{display:block;font-size:12px;color:var(--ink-soft);margin-bottom:7px;}
  .mirror-context-form textarea{width:100%;min-height:82px;resize:vertical;border:1px solid var(--line);border-radius:11px;background:var(--surface);color:var(--ink);font:var(--mirror-body)/1.65 var(--sans);padding:11px 13px;}
  .mirror-context-form button{margin-top:9px;}

  .mirror-row{display:grid;grid-template-columns:205px minmax(0,1fr);gap:28px;align-items:start;padding:28px 0;border-bottom:1px solid var(--line);}
  .mirror-row-label{display:flex;align-items:center;gap:14px;color:var(--accent);font-size:11.5px;font-weight:750;letter-spacing:.12em;text-transform:uppercase;padding-top:3px;}
  .mirror-row-label .mirror-mini-icon{width:46px;height:46px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--accent-soft);flex-shrink:0;}
  .mirror-row-copy{font-family:var(--serif);font-size:var(--mirror-body);line-height:1.65;}
  .mirror-row-note{font-family:var(--sans);font-size:var(--mirror-caption);line-height:1.55;color:var(--ink-faint);margin-top:3px;}
  .mirror-carry{padding-top:24px;padding-bottom:25px;}
  .mirror-carry .mirror-row-copy{font-size:var(--mirror-title);line-height:1.45;}
  .mirror-actions{display:flex;align-items:center;gap:28px;flex-wrap:wrap;margin-top:24px;}
  .mirror-primary{appearance:none;border:1px solid var(--accent);border-radius:99px;background:var(--accent);color:#fff;font:650 var(--mirror-ui)/1 var(--sans);padding:17px 38px;cursor:pointer;box-shadow:0 6px 16px rgba(62,92,82,.15);transition:background .16s,transform .16s,box-shadow .16s;}
  .mirror-primary:hover{background:var(--accent-deep);transform:translateY(-1px);box-shadow:0 8px 20px rgba(62,92,82,.2);}
  .mirror-primary.saved{background:var(--accent-deep);}
  .mirror-secondary{appearance:none;border:0;background:transparent;color:var(--accent);font:500 var(--mirror-ui)/1 var(--sans);padding:8px 5px;cursor:pointer;text-decoration:underline;text-decoration-color:rgba(62,92,82,.35);text-underline-offset:4px;}
  .mirror-secondary:hover,.mirror-secondary.active{color:var(--accent-deep);text-decoration-color:var(--accent-deep);}
  .mirror-action-note{font-family:var(--sans);font-size:var(--mirror-caption);color:var(--ink-faint);margin-top:14px;}
  .mirror-status{display:block;min-height:19px;font-family:var(--sans);font-size:12px;color:var(--accent-deep);margin-top:9px;}
  .mirror-status:empty{display:none;}
  .mirror-coverage{display:flex;align-items:center;gap:10px;color:var(--ink-faint);font-size:var(--mirror-caption);line-height:1.55;padding-top:30px;}
  .mirror-coverage svg{flex-shrink:0;}

  html[data-prototype-focus="reflection"] body{background:var(--surface-warm);background-image:none;}
  html[data-prototype-focus="reflection"] body > header,
  html[data-prototype-focus="reflection"] .docs-nav-shell{display:none !important;}
  html[data-prototype-focus="reflection"] #content{margin:0;}
  html[data-prototype-focus="reflection"] #content .doc-section{display:none !important;}
  html[data-prototype-focus="reflection"] #content #sec-wf{display:block !important;width:100%;max-width:none;margin:0;padding:0;border:0;border-radius:0;box-shadow:none;background:var(--surface-warm);}
  html[data-prototype-focus="reflection"] #sec-wf > :not(.app-frame){display:none !important;}
  html[data-prototype-focus="reflection"] .app-frame{min-height:100vh;border:0;border-radius:0;box-shadow:none;}
  html[data-prototype-focus="reflection"] .app-frame[data-active-view="v-reflection"] .app-body{min-height:100vh;}
  html[data-prototype-focus="reflection"] .app-frame[data-active-view="v-reflection"] .app-main{padding-top:54px;}

  @media(max-width:1080px){
    .app-frame[data-active-view="v-reflection"]{--mirror-display:27px;--mirror-title:21px;}
    .app-frame[data-active-view="v-reflection"] .app-side{width:210px;}
    .app-frame[data-active-view="v-reflection"] .app-main{padding-left:38px;padding-right:38px;}
    .mirror-row{grid-template-columns:174px minmax(0,1fr);}
  }
  @media(max-width:820px){
    #sec-wf{padding-left:24px;padding-right:24px;}
    .mirror-head{margin-bottom:38px;}
    .mirror-distribution{grid-template-columns:1fr 1fr;}
    .mirror-feedback{margin-left:0;}
    .mirror-row{grid-template-columns:1fr;gap:14px;}
  }

  /* ---- Privacy ---- */
  .priv-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;}
  @media(max-width:900px){.priv-grid{grid-template-columns:1fr;}}
  .priv-card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:20px 24px;}
  .priv-card h4{font-size:14px;font-weight:600;margin-bottom:4px;display:flex;align-items:center;gap:9px;}
  .priv-card .desc{font-size:12.5px;color:var(--ink-faint);margin-bottom:16px;}
  .priv-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid var(--line-soft);}
