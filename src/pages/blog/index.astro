---
import { getEmDashCollection } from "emdash";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = false;

const { entries } = await getEmDashCollection("posts", {
  status: "published",
  orderBy: { published_at: "desc" },
});

const formatDate = (date: Date | null | undefined) =>
  date?.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<BaseLayout
  title="Blog — HelpMeBe.Me"
  description="关于时间、记忆、隐私与诚实回顾的产品思考。"
  ogImage="/og.png"
>
  <header class="border-b border-line bg-paper/95">
    <div class="mx-auto flex h-18 max-w-[1040px] items-center justify-between px-6">
      <a href="/" class="flex items-center gap-3" aria-label="HelpMeBe.Me 首页">
        <svg width="28" height="28" viewBox="0 0 48 48" fill="none" aria-hidden="true">
          <path d="M 27.88 9.51 A 15 15 0 1 0 38.49 20.12" stroke="#3E5C52" stroke-width="3.4" stroke-linecap="round"></path>
          <circle cx="34.6" cy="13.4" r="3" fill="#3E5C52"></circle>
        </svg>
        <span class="font-serif text-[18px] font-medium">HelpMeBe.Me</span>
      </a>
      <nav class="flex items-center gap-5 text-sm text-ink-soft" aria-label="Blog 导航">
        <a class="transition-colors hover:text-ink" href="/">产品首页</a>
        <a class="transition-colors hover:text-ink" href="/_emdash/admin">后台</a>
      </nav>
    </div>
  </header>

  <main id="content" class="mx-auto max-w-[820px] px-6 py-20 sm:py-24">
    <div class="border-b border-line pb-12">
      <p class="text-[11px] font-bold tracking-[0.16em] text-accent uppercase">HelpMeBe.Me Journal</p>
      <h1 class="mt-4 font-serif text-3xl font-medium tracking-[-0.025em] sm:text-[36px]">看见时间，也记录思考。</h1>
      <p class="mt-5 max-w-2xl text-sm leading-7 text-ink-soft sm:text-[15px]">
        关于时间、记忆、隐私与诚实回顾的产品笔记。文章由 EmDash 管理，发布后无需重新构建网站。
      </p>
    </div>

    {
      entries.length === 0 ? (
        <section class="py-16 text-center">
          <p class="font-serif text-xl text-ink">还没有文章。</p>
          <a class="mt-5 inline-flex rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-white" href="/_emdash/admin/content/posts/new">
            写第一篇文章
          </a>
        </section>
      ) : (
        <div class="divide-y divide-line">
          {entries.map((post) => (
            <article class="py-10">
              <a class="group block" href={`/blog/${post.data.slug}/`}>
                <div class="flex flex-wrap items-center gap-2 text-[11px] text-ink-faint">
                  <span class="font-mono uppercase tracking-[0.08em]">Product Journal</span>
                  {post.data.publishedAt && <span aria-hidden="true">·</span>}
                  {post.data.publishedAt && (
                    <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
                  )}
                </div>
                <h2 class="mt-3 font-serif text-2xl font-medium tracking-[-0.015em] transition-colors group-hover:text-accent-deep">
                  {post.data.title}
                </h2>
                {post.data.excerpt && <p class="mt-4 text-sm leading-7 text-ink-soft sm:text-[15px]">{post.data.excerpt}</p>}
                <span class="mt-5 inline-flex text-xs font-semibold text-accent-deep">阅读全文 →</span>
              </a>
            </article>
          ))}
        </div>
      )
    }
  </main>

  <footer class="border-t border-line py-8">
    <div class="mx-auto flex max-w-[820px] items-center justify-between px-6 text-xs text-ink-faint">
      <span>© HelpMeBe.Me</span>
      <a class="transition-colors hover:text-ink" href="/">A private mirror for your time.</a>
    </div>
  </footer>
</BaseLayout>
